#!/usr/bin/env -S shelltest --execdir

# 1. dd
<
foo
bar
$ ./bin/keymaptest vim 'send ddp' 
bar
foo
>= 0

# 2. "+dd
<
foo
bar
$ ./bin/keymaptest vim 'send \"+dd' 'send \"+p'
bar
foo
>= 0

# 3. 2dd
<
foo
bar
baz
$ ./bin/keymaptest vim 'send 2dd' 'send p'
baz
foo
bar
>= 0

# 4. daw
<
foo bar
ab
$ ./bin/keymaptest vim 'send daw' 'send j' 'send p' 
bar
afoo b
>= 0

# 5. da)
<
(foo)
k
$ ./bin/keymaptest vim 'send da)' 'send j' 'send p' 

k(foo)
>= 0

# 6. di$ESC
<
(foo)
$ ./bin/keymaptest vim 'send di' 'send $ESC' 'expect NOR' 
(foo)
>= 0

# 7. test unkown char 
<
(foo)
$ ./bin/keymaptest vim 'send di' 'send z' 'expect NOR'
(foo)
>= 0

# 8. test special case: moving from operator to visual
<
(foo)
k
$ ./bin/keymaptest vim 'send di' 'send $ESC' 'expect NOR' 'send jv' 'expect VIS'
(foo)
k
>= 0

# 9. dt
<
fooxbar
k
$ ./bin/keymaptest vim 'send dtx' 'expect NOR' 'send jp'
xbar
kfoo
>= 0

# 10. df
<
fooxbar
k
$ ./bin/keymaptest vim 'send dfx' 'expect NOR' 'send jp'
bar
kfoox
>= 0
